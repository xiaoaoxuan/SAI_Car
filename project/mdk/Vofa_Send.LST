  197          /**
  198           * @brief  解析VOFA命令并执行对应操作
  199           * @param  cmd  以\0结尾的命令字符串
  200           * @retval 无
  201           * @note   支持实时调节PID参数、速度、前馈参数、风扇、启停
  202           *         命令格式: 参数名=浮点值! 或 start!/stop!
  203           */
  204          static void parse_command(const char *cmd)
  205          {
  206   1          float val;
  207   1      
  208   1          if (sscanf(cmd, "kp=%f", &val) == 1) {          // 舵机KP
  209   2              servo_pidf.kp = val;
  210   2          }
  211   1          else if (sscanf(cmd, "kg=%f", &val) == 1) {     // 陀螺仪阻尼系数
  212   2              servo_pidf.kg = val;
  213   2          }
  214   1          else if (sscanf(cmd, "kp_two=%f", &val) == 1) { // 舵机二次项系数
  215   2              servo_pidf.kp2 = val;
  216   2          }
  217   1          else if (sscanf(cmd, "motor_kp=%f", &val) == 1) { // 电机KP(左右同步)
  218   2              pid_lf.kp = val;
  219   2              pid_rf.kp = val;
  220   2          }
  221   1          else if (sscanf(cmd, "motor_ki=%f", &val) == 1) { // 电机KI(左右同步)
  222   2              pid_lf.ki = val;
  223   2              pid_rf.ki = val;
  224   2          }
  225   1          else if (sscanf(cmd, "motor_kd=%f", &val) == 1) { // 电机KD(左右同步)
  226   2              pid_lf.kd = val;
  227   2              pid_rf.kd = val;
  228   2          }
  229   1          else if (sscanf(cmd, "ff_scale=%f", &val) == 1) { // 前馈缩放系数
  230   2              g_ff_scale = val;
  231   2          }
  232   1          else if (sscanf(cmd, "ff_weight=%f", &val) == 1) { // 前馈融合权重
  233   2              g_ff_weight = val;
  234   2          }
  235   1          else if (sscanf(cmd, "diff_thres=%f", &val) == 1) { // 远近误差差异阈值
  236   2              g_diff_threshold = val;
  237   2          }
  238   1          else if (sscanf(cmd, "base_speed=%f", &val) == 1) { // 基础速度
  239   2              g_base_speed = (int16)val;
  240   2          }
  241   1          else if (sscanf(cmd, "diff_kp=%f", &val) == 1) { // 差速比例系数
  242   2              diff_kp = val;
  243   2          }
  244   1              else if (sscanf(cmd, "fan=%f", &val) == 1) {     // 风扇占空比(0-100)
  245   2                      if (val < 0) val = 0;
  246   2                      if (val > 100) val = 100;
  247   2                      g_fan_speed = val;
  248   2                      Negative_Pressure(g_fan_speed);
  249   2              }
  250   1          else if (strcmp(cmd, "start") == 0) {            // 启动
  251   2              g_motor_enable = 1;
  252   2              ControlFlag = 1;
  253   2          }
  254   1          else if (strcmp(cmd, "stop") == 0) {             // 停止
  255   2              g_motor_enable = 0;
C251 COMPILER V5.60.0,  Vofa_Send                                                          21/09/26  22:45:17  PAGE 5   

  256   2              ControlFlag = 0;
  257   2              Ring_Init();
  258   2              Motor_Stop();
  259   2          }
  260   1      }


