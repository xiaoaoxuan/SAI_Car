  165          /**
  166           * @brief  检查并解析WiFi接收缓冲区中的VOFA命令
  167           * @param  无
  168           * @retval 无
  169           * @note   以'!'为命令结束符，逐字节接收，完整命令后调用 parse_command()
  170           */
  171          void vofa_check_receive(void)
  172          {
  173   1          uint8 byte;
  174   1          uint32 len;
  175   1      
  176   1          if (!inited) return;
  177   1      
  178   1          while (1)
  179   1          {
  180   2              len = wifi_spi_read_buffer(&byte, 1);
  181   2              if (len == 0) break;
  182   2      
  183   2              if (byte == '!')
  184   2              {
  185   3                  rx_buffer[rx_index] = '\0';
  186   3                  parse_command(rx_buffer);
  187   3                  rx_index = 0;
  188   3              }
  189   2              else
C251 COMPILER V5.60.0,  Vofa_Send                                                          21/09/26  22:45:17  PAGE 4   

  190   2              {
  191   3                  if (rx_index < sizeof(rx_buffer) - 1)
  192   3                      rx_buffer[rx_index++] = byte;
  193   3              }
  194   2          }
  195   1      }
