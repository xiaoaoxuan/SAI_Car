  286          /**
  287           * @brief  DMA UART1接收中断：处理接收完成和半满中断
  288           * @note   检测0x7F自动下载指令，连续20次触发IAP_CONTR跳转
  289           */
  290          void DMA_UART1_IRQHandler(void) interrupt DMA_UR1R_VECTOR
  291          {
  292   1          static vuint8 dwon_count = 0;
  293   1      
  294   1          if (DMA_UR1R_STA & 0x01) // 半满中断
  295   1          {
  296   2              DMA_UR1R_STA &= ~0x01;      // 清标志位
  297   2              uart_rx_start_buff(UART_1); // 开启下一次接收，关闭当前
  298   2      
  299   2              // 自动下载检测：连续收到20个0x7F触发IAP跳转
  300   2              if (uart_rx_buff[UART_1][0] == 0x7F)
  301   2              {
  302   3                  if (dwon_count++ > 20)   // 0x7F自动下载计数阈值
  303   3                  {
  304   4                      IAP_CONTR = 0x60;
  305   4                  }
  306   3              }
  307   2              else
  308   2              {
  309   3                  dwon_count = 0;
  310   3              }
  311   2      
  312   2              if (uart_rx_handlers[UART_1] != NULL)
  313   2              {
  314   3                  uart_rx_handlers[UART_1](uart_rx_buff[UART_1][0]);
  315   3              }
  316   2          }
  317   1      
  318   1          if (DMA_UR1R_STA & 0x02) // 数据溢出
  319   1          {
C251 COMPILER V5.60.0,  isr                                                                14/06/26  22:56:49  PAGE 6   

  320   2              DMA_UR1R_STA &= ~0x02;      // 清标志位
  321   2              uart_rx_start_buff(UART_1); // 开启下一次接收，关闭当前
  322   2          }
  323   1      }
