   57           * @brief  舵机主循环：运行PID并输出PWM
   58           */
   59          void Servo_Loop(void)
   60          {
   61   1          // 运行舵机位置式PID，更新 Out_servo
   62   1          PID_servof(&servo_pidf);
   63   1      
   64   1          // 将PID计算结果输出到舵机PWM通道
   65   1          pwm_set_duty(SERVO_PWM1, (uint32)Out_servo);
   66   1      }
   67          
   68          /**
   69           * @brief  负压风机控制：0~100%占空比 → 50Hz PWM(1.0~1.8ms脉宽)
   70           * @param  duty  占空比(0-100)
   71           */
   72          void Negative_Pressure(uint32 duty)
   73          {
   74   1          uint32 PWM;
   75   1      
   76   1          // 占空比→PWM寄存器值：duty*24 + 3000（3000基准=100%占空/50Hz对应值）
   77   1          PWM = duty * 24 + 3000;
   78   1      
   79   1          // 限幅保护：1.0ms~1.8ms 脉宽对应 3000~5400
   80   1          if (PWM > 5400) PWM = 5400;   // 上限=1.8ms脉宽
   81   1          if (PWM < 3000) PWM = 3000;   // 下限=1.0ms脉宽
   82   1      
   83   1          // 双通道同步输出（两路风机并联）
   84   1          pwm_set_duty(SERVO_PWM3, PWM);
   85   1          pwm_set_duty(SERVO_PWM4, PWM);
   86   1      }


