   12          /**
   13           * @brief  设置舵机角度（相对87.5度中值±12.5度）
   14           */
   15          void servo_setAngle(pwm_channel_enum sever, float angle)
   16          {
   17   1          // 角度限幅：只允许±12.5度范围
   18   1          if (angle > 12.5 || angle < -12.5) return;
   19   1      
   20   1          // 转换为舵机绝对角度：中值87.5度，左转 angle 度
   21   1          angle = 87.5 - angle;
   22   1      
   23   1          // 计算占空比并输出
   24   1          pwm_set_duty(sever, SERVO_DUTY(angle));
   25   1      }
   26          
   27          /**
   28           * @brief  舵机4通道PWM初始化，SERVO_PWM1初始化为中值
   29           */
   30          void servo_init(void)
   31          {
   32   1          // 四路PWM初始化：舵机1=中值，舵机2/3/4=0（2空闲/3风机/4风机）
   33   1          pwm_init(SERVO_PWM1, SERVO_FREQ, SERVO_DUTY(87.5));
   34   1          pwm_init(SERVO_PWM2, SERVO_FREQ, 0);
   35   1          pwm_init(SERVO_PWM3, SERVO_FREQ, 0);
   36   1          pwm_init(SERVO_PWM4, SERVO_FREQ, 0);
   37   1      
   38   1          // 手动精确设置舵机1中值占空比为4450（消除浮点计算误差）
   39   1          pwm_set_duty(SERVO_PWM1, 4450);
   40   1      }
   41          
   42          /**
   43           * @brief  舵机中值死区过滤：4485~4565范围强制输出4450，消除中位抖动
   44           */
   45          volatile uint16 huQiqiangServo(volatile uint16 input)
   46          {
   47   1          // 中值死区(4485~4565) → 统一输出4450（中值）
   48   1          if ((input < 4565) && (input > 4485))
   49   1          {
   50   2              return (volatile uint16)4450;
   51   2          }
   52   1          // 死区外原样输出
   53   1          return input;
   54   1      }
   55          
   56          /**
