C251 COMPILER V5.60.0,  Motor                                                              14/06/26  22:56:47  PAGE 3   

  121          void Dream_speed(void)
  122          {
  123   1          uint16 tp_turn;
  124   1          int8 delta = (int8)g_steer_err;   // 转向误差转为8位有符号
  125   1      
  126   1          // 低通滤波状态变量（静态保持滤波记忆）
  127   1          static float diff_left_smooth = 0.0f;
  128   1          static float diff_right_smooth = 0.0f;
  129   1          #define DIFF_SMOOTH_ALPHA 0.5f   // 差速低通滤波系数
  130   1      
  131   1          // ---- 1. 计算差速值（内外轮速度差）----
  132   1          if (Out_servo > SERVO_CENTER)
  133   1          {
  134   2              // 左转：左轮减速、右轮加速
  135   2              tp_turn = Out_servo - SERVO_CENTER;
  136   2              diff_left  = (int16)(0.76f * delta * diff_kp);   // 左轮受0.76衰减
  137   2              diff_right = (int16)(-delta * diff_kp);           // 右轮全量
  138   2          }
  139   1          else
  140   1          {
  141   2              // 右转：右轮减速、左轮加速
  142   2              tp_turn = SERVO_CENTER - Out_servo;
  143   2              delta = -delta;
  144   2              diff_left  = (int16)(-delta * diff_kp);
  145   2              diff_right = (int16)(0.76f * delta * diff_kp);   // 右轮受0.76衰减
  146   2          }
  147   1      
  148   1          // 限幅：防止转向量超最大值
  149   1          if (tp_turn > MAX_TURN) tp_turn = MAX_TURN;
  150   1      
  151   1          // ---- 2. 弯道线性减速：转向越大，速度越低 ----
  152   1          tar_speed = g_base_speed - (uint32)(g_base_speed * (1.0f - g_speed_ratio)) * tp_turn / MAX_TURN;
  153   1      
  154   1          // ---- 3. 圆环降速：入环阶段额外降低目标速度 ----
  155   1          {
  156   2              extern uint8 ring_state;
  157   2              extern float g_ring_speed_factor;
  158   2              if (ring_state == 1 || ring_state == 2 || ring_state == 3 || ring_state == 4) {
  159   3                  tar_speed = (int16)((float)tar_speed * g_ring_speed_factor);
  160   3              }
  161   2          }
  162   1      
  163   1          // ---- 4. 有效行不足时提前减速（视野变短）----
  164   1          {
  165   2              extern uint8 valid_row_count;
  166   2              uint8 missing = 106 - valid_row_count;       // 缺失的有效行数
  167   2              int16 preview = (int16)missing * 20 / 106;    // 按比例换算减速量
  168   2              tar_speed -= preview;
  169   2              if (tar_speed < 40) tar_speed = 40;            // 最低速度保护
  170   2          }
  171   1      
  172   1          // ---- 5. 差速低通滤波：平滑差速变化，减少突变抖动 ----
  173   1          diff_left_smooth  = DIFF_SMOOTH_ALPHA * diff_left  + (1.0f - DIFF_SMOOTH_ALPHA) * diff_left_smooth;
  174   1          diff_right_smooth = DIFF_SMOOTH_ALPHA * diff_right + (1.0f - DIFF_SMOOTH_ALPHA) * diff_right_smooth;
  175   1      
  176   1          diff_left  = (int16)diff_left_smooth;
  177   1          diff_right = (int16)diff_right_smooth;
  178   1      }
