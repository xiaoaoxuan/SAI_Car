   46          /**
   47           * @brief  计算两像素的和差比对比度: |diff| * 200 / (sum + 1)，值越大差异越显著
   48           * @param  temp1  像素值1
   49           * @param  temp2  像素值2
   50           * @retval 对比度值
   51           * @note   和差比公式: contrast = |A-B| / (A+B) * 200
   52           *         分母+1防止除零；200是放大系数，使结果在0~200范围
   53           */
   54          uint16 get_contrast(uint8 temp1, uint8 temp2)
   55          {
C251 COMPILER V5.60.0,  image                                                              14/06/26  22:56:46  PAGE 2   

   56   1          int16 diff = (int16)temp1 - (int16)temp2;                     // 带符号差值
   57   1          return  (uint16)((diff < 0 ? -diff : diff) * 200 / (temp1 + temp2 + 1));  // 和差比
   58   1      }
