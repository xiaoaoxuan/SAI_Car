   57          /**
   58           * @brief  增量式PID：delta = kp*d_err + ki*error + kd*dd_err，用于电机速度闭环
   59           * @param  pid      PID结构体指针
   60           * @param  tar_val  目标值
   61           * @param  act_val  实际值
   62           * @retval 无 (更新 pid->out)
   63           */
   64          void Increment_PIDf(volatile PID_tf *pid, float tar_val, float act_val)
   65          {
   66   1          float error, d_err, dd_err, delta, new_out;
   67   1      
   68   1          // 计算当前误差及一阶/二阶差分
   69   1          error  = tar_val - act_val;                         // 当前误差
   70   1          d_err  = error - pid->err1;                         // 一阶差分（误差变化量）
   71   1          dd_err = error - 2 * pid->err1 + pid->err2;         // 二阶差分（误差变化加速度）
   72   1      
   73   1          // 增量式PID：delta = Kp * d_err + Ki * error + Kd * dd_err
   74   1          delta  = pid->kp * d_err;                           // 比例项：响应速度变化
   75   1          delta += pid->ki * error;                           // 积分项：消除稳态误差
   76   1          delta += pid->kd * dd_err;                          // 微分项：抑制超调
   77   1      
   78   1          // 累加增量 → 绝对值输出
   79   1          new_out = pid->out + delta;
   80   1      
   81   1          // 输出限幅保护
   82   1          pid->out = limit_float(new_out, OUT_MIN, OUT_MAX);
   83   1      
   84   1          // 更新误差历史
   85   1          pid->err2 = pid->err1;   // err2 ← 上上次误差
   86   1          pid->err1 = error;       // err1 ← 上次误差
   87   1      }
