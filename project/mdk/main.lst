   89          /**
   90           * @brief  5ms定时中断处理函数
   91           * @param  无
   92           * @retval 无
   93           * @note   每5ms执行: 陀螺仪读取→陀螺仪积分→编码器读取→打靶中断处理→
   94           *         启停检测(ControlFlag下降沿触发急停)→电机控制→舵机控制→计时器累加
   95           */
   96          void pit_handler(void)
   97          {
   98   1          static uint8 last_ControlFlag = 0;
   99   1      
  100   1          imu660ra_get_gyro();
  101   1              Gyro_Integrate();
  102   1          Encoder_GetValue();
  103   1      
  104   1          Aim_Process_Interrupt();
  105   1      
  106   1          if (last_ControlFlag == 1 && ControlFlag == 0)
  107   1          {
  108   2              Motor_Stop();
  109   2          }
  110   1          last_ControlFlag = ControlFlag;
  111   1      
  112   1          if (ControlFlag)
  113   1          {
  114   2              Motor_Loop();
  115   2          }
  116   1      
  117   1          Servo_Loop();
  118   1          time++;
  119   1      }
